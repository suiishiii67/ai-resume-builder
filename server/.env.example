# Copy this file to .env and fill in the values
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/ai-resume-builder
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# The one admin account (npm run create-admin)
ADMIN_NAME=your-name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password1

# Gemini AI (Phase 3): get a key from Google AI Studio
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=your-main-model
GEMINI_FALLBACK_MODEL=your-backup-model
